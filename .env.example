# Copy to .env and fill in as needed. NEVER commit .env.
# MemCheck reads all secrets from environment variables only.

# --- Paid run controls (both are required before any paid provider call) ---
# Any value other than "true" (case-insensitive) blocks paid providers.
ALLOW_PAID_RUNS=false
# Hard ceiling for the estimated cost of a single experiment run, in USD.
MAX_EXPERIMENT_COST_USD=0

# --- Provider credentials (optional; only needed for paid runs) ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- Optional overrides ---
# Directory holding downloaded benchmark data (default: data/raw)
# MEMCHECK_DATA_DIR=data/raw
# Anonymize generated paper artifacts (1 = anonymous build)
# MEMCHECK_ANONYMOUS=0
